# 复制为 .env 后修改：cp .env.example .env

# 应用镜像（需事先 docker build 或 docker load）
BIT_LABS_IMAGE=bit-labs:v1.0.0

# Caddy 对外端口
HTTP_PORT=80
HTTPS_PORT=443

# PostgreSQL（需与 deploy/conf/database.yaml 一致）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=bitlabs

# Redis（需与 deploy/conf/redis.yaml 一致）
REDIS_PASSWORD=
