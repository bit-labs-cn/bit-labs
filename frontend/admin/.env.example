# owl-ui / owl-ui-builder 环境变量模板
# 用法：cp .env.example .env 后按本机修改；.env.development / .env.production 可按环境覆盖本文件。

# ---------- 业务必填 ----------
# 项目短名（原 builder.projects.yaml 的 key）
VITE_APP_SYSTEM = bit-labs
# 平台标题（浏览器 title / 登录副标题等）
VITE_APP_TITLE = 比特实验室
# API 基础地址；开发环境通常为后端地址（Vite 代理 target），正式环境多为 /
VITE_BASE_URL = http://127.0.0.1:8087/

# ---------- 常用可配 ----------
# 开发服务器起始端口（占用时自动顺延）
VITE_PORT = 8851
# Vite base / 静态资源公共路径
VITE_PUBLIC_PATH = /
# 路由模式：hash | history
VITE_ROUTER_HISTORY = "hash"
# 是否走 CDN 资源
VITE_CDN = false
# 是否隐藏默认首页
VITE_HIDE_HOME = true
# 构建压缩：none | gzip | brotli | both | gzip-clear | brotli-clear | both-clear
VITE_COMPRESSION = "none"

# ---------- 可选 ----------
# 自定义入口（相对 frontend/admin，默认 main.ts）
# VITE_APP_ENTRY = main.ts

# ---------- 由 owl-ui-builder 启动时自动注入（勿手改，可省略）----------
# VITE_APP_ENTRY_FILE =
# VITE_APP_OUT_DIR =
# VITE_APP_PROJECT_ROOT =
# VITE_APP_LOGO_PATH =
